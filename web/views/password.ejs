<%- include('partials/header', { pageTitle: 'Смена пароля' }) %>

<div class="login-box">
  <div class="login-brand">
    <span class="brand__mark"><svg class="icon" aria-hidden="true"><use href="#i-key"></use></svg></span>
    <span>Учётка <small><%= admin.login %></small></span>
  </div>
  <h1>Смена пароля</h1>
  <% if (error) { %>
    <div class="error" role="alert"><%= error %></div>
  <% } %>
  <form method="POST" action="/password" class="form-stack">
    <label class="field">
      <span class="field__label">Текущий пароль</span>
      <input name="current" type="password" required autofocus autocomplete="current-password" />
    </label>
    <label class="field">
      <span class="field__label">Новый пароль</span>
      <input name="password" type="password" required minlength="<%= minLength %>" autocomplete="new-password" />
      <span class="hint">Не короче <%= minLength %> символов</span>
    </label>
    <label class="field">
      <span class="field__label">Новый пароль ещё раз</span>
      <input name="password2" type="password" required minlength="<%= minLength %>" autocomplete="new-password" />
    </label>
    <button type="submit" class="btn btn-primary">Сменить пароль</button>
  </form>
  <div class="hint center">Остальные, кто вошёл под этой учёткой, будут разлогинены</div>
</div>

<%- include('partials/footer') %>
