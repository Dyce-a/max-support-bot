# Скопируйте этот файл в .env и заполните.
# Сам .env в git не попадает (см. .gitignore), там будут ваши пароли и токен.

# Токен бота MAX. СЮДА НАДО ВСТАВИТЬ СВОЙ ТОКЕН, без него бот не запустится.
# Где взять: business.max.ru -> Чат-боты -> ваш бот -> Настройки -> поле "Токен"
BOT_TOKEN=

# PostgreSQL
PG_HOST=localhost
PG_PORT=5432
PG_USER=bot_support
PG_PASSWORD=bot_support
PG_DB=bot_support

# Порт веб-панели
PORT=3000

# Публичный адрес панели. Из него строятся ссылки в QR-кодах и кнопка сканера в боте.
# Камера в браузере работает только по https, поэтому на сервере тут должен быть
# ваш домен (или адрес туннеля). Для запуска на своём компьютере хватит localhost.
PUBLIC_URL=http://localhost:3000

# 1 - если адрес мини-аппа (PUBLIC_URL/scan) прописан в кабинете business.max.ru
# (Чат-боты -> бот -> Расширенные настройки). Тогда бот показывает нативный сканер MAX,
# а наклейки открывают мини-апп. 0 - сканер открывается обычной ссылкой в браузере.
MAX_MINIAPP=0

# Ссылка на вашего бота в MAX, например https://max.ru/my_support_bot
# Наклейка, отсканированная камерой телефона, ведёт сюда с кодом аудитории.
# Если оставить пустым, вместо перехода в бота откроется страница аудитории.
BOT_LINK=

# Подпись в шапке QR-наклейки
ORG_NAME=Мой университет

# Секрет для подписи куки админки. На сервере обязательно свой:
#   openssl rand -hex 32
# Если пусто, ключ генерируется при каждом запуске и вход в панель слетает после перезапуска.
SESSION_SECRET=

# 1 - когда панель реально открывается по https, ставит флаг secure на куку.
# Если поставить 1 при http, браузер перестанет слать куку и войти не получится.
COOKIE_SECURE=0
